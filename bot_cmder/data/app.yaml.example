# bot-cmder application config — full reference.
#
# Every settable field is shown explicitly, with its default value
# uncommented. Copy to `config/app.yaml` and tighten / strip down to
# what your deployment actually needs.
#
# Secrets (Telegram token, webhook secret, master key) live in `.env`,
# not here. This file is safe to commit.
#
# `whoami` is the easiest way to discover the norm_id strings you need
# below — run `/whoami` in your bot DM and copy the value it prints.

# ---------------------------------------------------------------------
# State paths at a glance
# ---------------------------------------------------------------------
# bot-cmder writes three things to disk during normal operation. Set
# them up here so a glance at this section tells you where state lives.
# All three default to `./var/...` (relative to the process CWD); for
# prod, pin to absolute paths and `mkdir -p` the parents before serve.
#
#   audit.path                   ./var/audit.jsonl
#   totp.secret_store_path       ./var/totp.sqlite
#   runbook.dir                  ./runbooks
#
# Issue #20 will add XDG-aware defaults for installed users; until then
# these CWD-relative paths are the contract.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Phase 1 — identity + access control
# ---------------------------------------------------------------------

users:
  - id: zonda
    aliases: ["telegram:1234567890"]   # placeholder — replace with your real norm_id
    role: sre

  # - id: alice
  #   aliases: ["telegram:1234567891", "discord:222...232", "slack:U0X...A2B"]
  #   role: viewer

acl:
  # Anyone in these roles can run any SAFE command that doesn't have its
  # own command-specific override below.
  default_allow_safe: ["role:sre", "role:viewer"]

  # Per-command override. Keys are command names (post-router-rewrite,
  # i.e. `service_restart`, not `service restart` — same string the
  # audit log records under `command:`). Values are allow rules
  # (norm_ids or `role:<name>`). PRIVILEGED commands deny by default
  # unless they appear here.
  commands: {}
  # commands:
  #   kubectl:        ["role:sre"]
  #   service_restart:["role:sre"]
  #   ssh:            ["role:sre"]

# ---------------------------------------------------------------------
# Phase 1 — HTTP healthcheck targets (`/health`)
# ---------------------------------------------------------------------

healthcheck:
  targets:
    - name: api
      url: https://api.example.com/healthz
      expect_status: 200
      timeout_s: 5.0
    # - name: db
    #   url: https://db.example.com/ping
    #   expect_status: 200
    #   timeout_s: 5.0

# ---------------------------------------------------------------------
# Phase 1 — append-only audit log
# ---------------------------------------------------------------------
# Every command attempt, ACL deny, OTP event, SSH connection,
# emergency-bypass grant/use/revoke gets a JSONL line here. Treat as
# tamper-evidence + post-mortem source.
#
# Rotation (issue #28) is built in. Defaults are tuned for a typical
# SRE deployment: daily UTC midnight rotation, 100 MB hard size cap,
# 7 backups (one week), gzipped. Override per field below; omit the
# rotation block entirely to take the defaults.

audit:
  # Absolute path strongly recommended in prod. The parent directory
  # must exist before `bot-cmder serve` starts.
  path: ./var/audit.jsonl

  rotation:
    # Hard size cap on the active file. When the next write would
    # push it past this many bytes, rotate. 0 disables size-based
    # rotation (then `when` must be set to anything other than "off").
    max_bytes: 100000000   # 100 MB

    # Time-based trigger. One of:
    #   "off"      — no time-based rotation (only size triggers)
    #   "hourly"   — rotate at top of every UTC hour
    #   "daily"    — rotate every 24h after the first write
    #   "midnight" — rotate at UTC 00:00 (daily, anchored to wall-clock
    #                midnight; matches "what happened on date X"
    #                forensics queries)
    #   "weekly"   — rotate Mondays at UTC 00:00
    when: midnight

    # Number of rotated files to retain before unlinking the oldest.
    # 0 disables pruning (lets old files accumulate without bound —
    # use only with external retention management).
    backup_count: 7

    # Gzip rotated files. JSONL compresses ~10x; cheap CPU at rotation
    # time, big disk savings. Set false if you want rotated files
    # immediately tail-able without `gunzip -c`.
    compress: true

# ---------------------------------------------------------------------
# Phase 2 — TOTP gate for PRIVILEGED commands
# ---------------------------------------------------------------------
# The SQLite database stores per-user Fernet-encrypted TOTP secrets.
# Lose this file → every enrolled user has to re-run `bot-cmder
# enroll-totp`. Lose the master key (`.env: BOT_CMDER_MASTER_KEY`) →
# the same, the file becomes unreadable.

totp:
  # SQLite database holding Fernet-encrypted TOTP secrets per norm_id.
  # Treat backup-importance as equal to a passwords vault.
  secret_store_path: ./var/totp.sqlite

  # How long a privileged command waits for `/otp <code>` before the
  # pending session is discarded. Telegram users get this many seconds
  # to reply with the code before the original command has to be rerun.
  session_ttl_s: 120

  # Issue #15 — hard cap (in minutes) on `/otp emergency <minutes>`
  # window duration. Operators can request shorter windows; anything
  # above this is silently capped (the reply text + audit log surface
  # the actual granted duration). Set lower for stricter teams; higher
  # if your incident playbook demands longer hands-off windows.
  # Disable the feature entirely by setting to 0 — the cap floor is 1
  # min, so 0 here makes every grant request fall back to 1 min, NOT
  # zero out emergency mode. (Proper "disable emergency mode" knob is
  # tracked separately if needed.)
  emergency_max_minutes: 60

# ---------------------------------------------------------------------
# Phase 2 — /kubectl builtin (PRIVILEGED)
# ---------------------------------------------------------------------

kubectl:
  # Pin a specific kubeconfig file. Leave commented to inherit the bot
  # process's KUBECONFIG / ~/.kube/config.
  # kubeconfig: /home/bot/.kube/config

  # Hard whitelist of subcommands the bot will exec. Adding `exec`,
  # `delete`, `apply` etc. is at your own risk — these defaults are
  # deliberately read-mostly + benign ops.
  allowed_subcommands: [get, describe, logs, rollout, scale, top]

  # Per-call output cap; longer kubectl output is truncated with a
  # `[...truncated N bytes]` marker.
  max_output_bytes: 3500

# ---------------------------------------------------------------------
# Phase 2 — /runbook list and /runbook run
# ---------------------------------------------------------------------

runbook:
  # Directory containing executable scripts (chmod +x *.sh / *.py).
  # Treat as code: gitops-manage it, code-review additions; whoever
  # can write here controls everything bot-cmder can do.
  dir: ./runbooks

  # Per-call output cap for runbook stdout/stderr.
  max_output_bytes: 3500

# ---------------------------------------------------------------------
# Phase 3 — SSH connector tuning
# ---------------------------------------------------------------------
# Defaults are fine for daily use. Tune `pool_ttl_s` higher if you have
# many short-lived `/service status` calls; tune `command_timeout_s`
# lower if you want stricter "don't hang the bot" SLA per command.

ssh:
  pool_ttl_s: 300         # reuse one SSH connection per host for 5 min
  command_timeout_s: 30   # hard limit per remote command
  max_output_bytes: 3500  # truncate longer remote stdout/stderr

# ---------------------------------------------------------------------
# Phase 3 — SSH-reachable hosts
# ---------------------------------------------------------------------
# Each key under `hosts` is the canonical name `/service` and `/ssh`
# refer to. Strict known_hosts checking is always on; if `known_hosts`
# is unset, asyncssh falls back to the bot user's ~/.ssh/known_hosts.
#
# `allowed_commands` only governs the `/ssh` escape hatch: the joined
# command string must fully-match at least one regex. `/service-*`
# actions ignore it because the action templates ARE the allowlist.

hosts: {}
# hosts:
#   server-a:
#     address: 10.0.1.5
#     user: deploy
#     port: 22                                       # default 22
#     key_path: /etc/bot-cmder/keys/server-a.ed25519
#     known_hosts: /etc/bot-cmder/known_hosts       # default ~/.ssh/known_hosts
#     allowed_commands:
#       - "^sudo systemctl (status|restart) (api|worker)\\.service$"
#       - "^sudo journalctl -u (api|worker)\\.service .*$"
#   server-b:
#     address: 10.0.1.6
#     user: deploy
#     key_path: /etc/bot-cmder/keys/server-b.ed25519
#     allowed_commands: []                           # /ssh fully disabled for this host

# ---------------------------------------------------------------------
# Phase 3 — services with predefined actions
# ---------------------------------------------------------------------
# Each action key under a service auto-registers a corresponding
# `/service <action>` subcommand on bot startup. Add `sysinfo:
# "uname -a"` here, restart the bot, and `/service sysinfo <name>`
# is live. No code change.
#
# Risk + execution shape derive from the action's *name*:
#
#   - Read-shaped names — status / logs / sysinfo / health / check /
#     show / inspect / df / top / ps / ls / list / cat / tail / head /
#     uptime / ping / ... — are SAFE. They fan out across every host
#     in the service's `hosts` list in parallel; no --host needed,
#     no OTP required (still gated by acl.commands.<key> if present).
#   - Everything else (restart / deploy / drain / ...) is PRIVILEGED:
#     TOTP-gated and refuses to run without an explicit `--host X`,
#     even if there's only one host configured. Conservative default:
#     "I don't know what `deploy` does, so ask twice."
#
# ACL config keys for the auto-registered subcommands stay
# `acl.commands.service_<action>` (e.g. service_restart). You can
# tighten read actions further by adding the same form there.

services: {}
# services:
#   api:
#     hosts: [server-a, server-b]
#     actions:
#       status:  "sudo systemctl status api.service"      # SAFE  fan-out
#       logs:    "sudo journalctl -u api.service -n 100"  # SAFE  fan-out
#       sysinfo: "uname -a"                               # SAFE  fan-out
#       restart: "sudo systemctl restart api.service"     # PRIV  --host required
#       deploy:  "/usr/local/bin/deploy-api"              # PRIV  --host required

# ---------------------------------------------------------------------
# Phase 5 — Slack adapter knobs
# ---------------------------------------------------------------------
# Slack slash commands can reply two ways:
#   - ephemeral   : only the user who invoked the command sees the reply
#   - in_channel  : everyone in the channel sees the reply
#
# `reply_visibility` modes:
#   - `by_risk`    SAFE → in_channel, PRIVILEGED → ephemeral (recommended)
#   - `in_channel` everything goes to channel — collaborative ops
#   - `ephemeral`  everything stays private — paranoid mode
#
# `visibility_overrides` tweaks individual commands. Keys are the
# synthetic command names the dispatcher records (e.g. `service_restart`,
# not `service restart`) — same string `audit.jsonl` records under
# `command:`, easy to copy. Values must be `in_channel` or `ephemeral`
# (the override resolves to one of the two final states).

slack:
  reply_visibility: by_risk        # by_risk | in_channel | ephemeral
  visibility_overrides: {}
  # visibility_overrides:
  #   whoami:          ephemeral   # don't broadcast user IDs
  #   help:            in_channel  # team learns by lurking
  #   service_status:  in_channel  # ops dashboard vibe
  #   service_logs:    ephemeral   # logs may carry sensitive data
