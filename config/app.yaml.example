# bot-cmder application config.
#
# Secrets (Telegram token, webhook secret) live in `.env`. This file is
# safe to commit. Copy to `config/app.yaml` and edit.
#
# `whoami` is the easiest way to discover the norm_id strings you need
# below — run `/whoami` in your bot DM and copy the value it prints.

users:
  - id: zonda
    aliases: ["telegram:111111111"]
    role: sre

  # - id: alice
  #   aliases: ["telegram:222222222"]
  #   role: viewer

acl:
  # Anyone in these roles can run any SAFE command that doesn't have its
  # own command-specific override below.
  default_allow_safe: ["role:sre", "role:viewer"]

  # Per-command override. Keys are command names; values are allow rules
  # (norm_ids or "role:<name>"). Privileged commands deny by default
  # unless they appear here. Leave as `{}` if you have no overrides.
  commands: {}
  # commands:
  #   restart: ["role:sre"]
  #   kubectl: ["role:sre"]

healthcheck:
  targets:
    - {name: api, url: https://api.example.com/healthz, expect_status: 200, timeout_s: 5}
    # - {name: db, url: https://db.example.com/ping}

audit:
  path: ./var/audit.jsonl

# Phase 2 — TOTP gate for privileged commands.
totp:
  secret_store_path: ./var/totp.sqlite
  # How long a privileged command waits for `/otp <code>` before the
  # pending session is discarded.
  session_ttl_s: 120

# Phase 2 — /kubectl builtin.
kubectl:
  # Optional: pin a specific kubeconfig file. If unset, the bot
  # process inherits KUBECONFIG / ~/.kube/config.
  # kubeconfig: /home/bot/.kube/config

  # Hard whitelist of subcommands the bot will exec. Add `exec`,
  # `delete`, `apply` etc. at your own risk — these defaults are
  # deliberately read-mostly + benign ops.
  allowed_subcommands: [get, describe, logs, rollout, scale, top]

  # Per-call output cap; longer kubectl output is truncated.
  max_output_bytes: 3500

# Phase 2 — /runbook_list and /runbook_run.
runbook:
  # Directory containing executable scripts. Treat as code: gitops
  # it, code-review additions; whoever can write here controls
  # everything bot-cmder can do.
  dir: ./runbooks
  max_output_bytes: 3500

# Phase 3 — SSH connector tuning. Defaults are fine for daily use.
ssh:
  pool_ttl_s: 300         # reuse one SSH connection per host for 5 min
  command_timeout_s: 30   # hard limit per remote command
  max_output_bytes: 3500

# Phase 3 — SSH-reachable hosts. Each key is the canonical name
# /service and /ssh refer to. Strict known_hosts checking is
# always on; if `known_hosts` is unset, asyncssh falls back to
# the bot user's ~/.ssh/known_hosts.
#
# `allowed_commands` only governs the /ssh escape hatch: the joined
# command string must fully-match at least one regex. /service-*
# actions ignore it because the action templates ARE the allowlist.
hosts: {}
# hosts:
#   server-a:
#     address: 10.0.1.5
#     user: deploy
#     port: 22                                    # default 22
#     key_path: /etc/bot-cmder/keys/server-a.ed25519
#     # known_hosts: /etc/bot-cmder/known_hosts  # default ~/.ssh/known_hosts
#     allowed_commands:
#       - "^sudo systemctl (status|restart) (api|worker)\\.service$"
#       - "^sudo journalctl -u (api|worker)\\.service .*$"
#   server-b:
#     address: 10.0.1.6
#     user: deploy
#     key_path: /etc/bot-cmder/keys/server-b.ed25519

# Phase 3 — services with predefined actions. /service_status fans
# out across hosts in parallel; /service_restart and /service_logs
# require an explicit `--host <name>` argument.
services: {}
# services:
#   api:
#     hosts: [server-a, server-b]
#     actions:
#       status:  "sudo systemctl status api.service"
#       restart: "sudo systemctl restart api.service"
#       logs:    "sudo journalctl -u api.service -n 100 --no-pager"
